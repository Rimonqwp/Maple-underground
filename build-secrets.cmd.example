@echo off
REM ============================================================================
REM  Database secrets TEMPLATE. Copy this file to build-secrets.cmd
REM  (build-secrets.cmd is git-ignored) and fill in the real passwords.
REM  build-all.cmd bakes these values into the main plugin underground_state
REM  at compile time. To change DB settings, edit build-secrets.cmd and re-run
REM  build-all.cmd -- no server-side config file is needed.
REM
REM  Rule: the whole series shares ONE host (DB_HOST). Each schema has its own
REM  user/password. To add a data source: add a DB_<NAME>_* group here and keep
REM  underground_state/pom.xml, database.properties and the DB_PROPS block in
REM  build-all.cmd in sync.
REM  NOTE: keep this file ASCII-only -- cmd.exe mis-parses non-ASCII comments.
REM ============================================================================

REM ---- shared host ----
set "DB_HOST=api.maplenw.top"
set "DB_PORT=3306"

REM ---- state: the main plugin's own schema ----
set "DB_STATE_DATABASE=underground_state"
set "DB_STATE_USER=underground_state"
set "DB_STATE_PASSWORD="

REM ---- caves: schema used by the underground_caves sub-plugin ----
set "DB_CAVES_DATABASE=underground_caves"
set "DB_CAVES_USER=underground_caves"
set "DB_CAVES_PASSWORD="

REM ---- skyblock: schema used by auto-ready data ----
set "DB_SKYBLOCK_DATABASE=skyblock"
set "DB_SKYBLOCK_USER=skyblock"
set "DB_SKYBLOCK_PASSWORD="
